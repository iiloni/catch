# Production: copy to .env next to docker-compose.yml and fill in.
BETTER_AUTH_URL=https://catch.example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=change-me
ELECTRIC_SECRET=change-me
# The first account made is the admin. After it, sign-up is closed and the admin invites
# people from Settings > Admin > Users. `open` lets anyone make an account.
# REGISTRATION=closed
# The reverse proxy in front of Catch, as IP addresses or CIDR ranges, comma separated. Its
# X-Forwarded-For is then believed for the sign-in rate limit. From a proxy on the Docker
# host, connections arrive from the Compose network's gateway (docker network inspect).
# List that one address rather than a range: anything in it can pick its own rate limit.
# TRUSTED_PROXIES=172.18.0.1
# The most attachment storage one account may use, in megabytes. 0 removes the limit.
# ATTACHMENT_QUOTA_MB=10240
# CATCH_PORT=3000
# CATCH_BIND_ADDRESS=0.0.0.0
# The server fetches the pages your notes link to for previews. false turns that off.
# LINK_PREVIEWS=true
# Reminder notifications go through browsers' push services, which are told whom to contact
# about this server: a mailto: or https: address. Defaults to BETTER_AUTH_URL's origin when
# that is https; set it when the server is reached over plain HTTP.
# PUSH_CONTACT=mailto:you@example.com
# File attachments use a named Docker volume by default. To bind a host directory:
# CATCH_ATTACHMENTS_MOUNT=/path/to/attachments
# Server backups use a named Docker volume too. A host directory, ideally on another disk
# (writable by UID 1000), keeps them when this disk or its volumes are lost:
# CATCH_BACKUPS_MOUNT=/path/to/backups
# Before a new version migrates the database, the server backs it up and keeps the last 10.
# UPDATE_BACKUPS=true
# UPDATE_BACKUPS_KEPT=10

# Development: worktree stacks generate their own settings in .env.worktree
# (see WORKTREES.md). Values here in the primary checkout's .env are shared by
# every worktree stack, which is where future API keys belong.
