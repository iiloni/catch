# Copy to .env for local development.
DATABASE_URL=postgres://catch:catch@localhost:5432/catch
ELECTRIC_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# The Vite dev server calls the API from a different origin.
TRUSTED_ORIGINS=http://localhost:5173

# Production (docker compose) only.
POSTGRES_PASSWORD=change-me
ELECTRIC_SECRET=change-me
