<?xml version="1.0"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:foreground="@drawable/widget_row_feedback">
  <ImageView android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_card_default" android:scaleType="fitXY" android:importantForAccessibility="no"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:padding="12dp" android:orientation="vertical">
    <TextView android:id="@+id/widget_title" android:textColor="@color/widget_ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="120dp" android:layout_marginTop="8dp" android:background="@drawable/widget_image_frame" android:clipToOutline="true" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/widget_image_preview"/>
    <TextView android:id="@+id/widget_body" android:textColor="@color/widget_ink" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="6dp" android:lineSpacingExtra="2dp"/>
  </LinearLayout>
</FrameLayout>
