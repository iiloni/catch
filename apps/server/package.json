{
  "name": "@catch/server",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/backups/cli.ts"
  },
  "dependencies": {
    "@catch/shared": "workspace:*",
    "@electric-sql/client": "^1.5.28",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
